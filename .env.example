# Copy to .env for local development; use development/test keys here.
# Production keys and server settings live only on the server in deploy/.env.
# Optional paid geocoder; used after cheaper enabled providers.
MAPBOX_ACCESS_TOKEN=
# Free public Nominatim: maximum 1 request/second across the application.
# Identify your app, cache results, and display OpenStreetMap attribution.
# No autocomplete or systematic queries; bulk use has stricter limits:
# https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_RATE_PER_SECOND=1
# Free public Photon demo: reasonable use only; heavy use may be throttled
# or banned. No availability guarantee: https://photon.komoot.io/
# Use your own instance for volume; unset disables Photon.
PHOTON_URL=https://photon.komoot.io
# Optional second internal geocoder; source is checked per result.
PELIAS_URL=
# Optional paid providers. No credential means no calls.
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
HERE_API_KEY=
ARCGIS_API_KEY=
GOOGLE_MAPS_API_KEY=
# Paid storage modes; temporary results are never cached.
MAPBOX_PERMANENT=false
ARCGIS_FOR_STORAGE=false
# Cache off disables results storage, but shared quota writes remain required.
OPENTAXRATE_GEOCODE_CACHE=on
# Strict read-only: cached placements only, no outside geocoding calls.
OPENTAXRATE_GEOCODE_READ_ONLY=false
CENSUS_DISABLED=false
# Every provider accepts <ID>_DAILY_CAP, <ID>_RATE_PER_SECOND and
# <ID>_COST_PER_CALL. Esri uses ARCGIS_. Zero cap/rate disables calls.
# Daily caps reset at UTC midnight and are shared across API replicas.
CENSUS_DAILY_CAP=100000
PHOTON_DAILY_CAP=100000
PELIAS_DAILY_CAP=100000
GEOCODIO_DAILY_CAP=2500
SMARTY_DAILY_CAP=100
MAPBOX_DAILY_CAP=300
HERE_DAILY_CAP=300
ARCGIS_DAILY_CAP=300
GOOGLE_DAILY_CAP=300
# Optional. Standardizes a range state's address its typed street doesn't
# place, for its ZIP+4 (Utah publishes only ZIP+4 ranges).
GEOCODIO_API_KEY=
# Optional. TypeSafe's Jev picks the ZIP's street a misspelled one is, when
# spelling alone can't. About $0.12 per 1,000 picks.
TYPESAFE_API_KEY=
# Optional. Stripe Tax benchmark comparisons; use a test secret key locally.
STRIPE_SECRET_KEY=
# Optional. Local Stripe webhook signing secret, when testing webhook integrations.
STRIPE_WEBHOOK_SECRET=
# Sent to the states' sites; include a contact.
OPENTAXRATE_USER_AGENT=opentaxrate (+https://github.com/you/your-fork; you@example.com)
# Streamlined and Missouri rows that ended before this date are not loaded
# (default 2020-01-01). Map-state rates are always kept in full.
OPENTAXRATE_HISTORY_FROM=
PORT=8080
DB_PORT=5433
# For a public deployment; each is off when unset.
# Origins allowed to call the API from a browser, comma-separated
# (e.g. https://opentaxrate.com,http://localhost:5173). Unset: no CORS headers.
OPENTAXRATE_CORS_ORIGINS=
# Lookups allowed per IP on /v1/rate, as count/unit pairs (s, min, hour, day).
# Over it: 429 RATE_LIMITED with Retry-After. Counts are per process, in memory.
OPENTAXRATE_PUBLIC_LIMIT=
# 1 to count by Cloudflare's CF-Connecting-IP header instead of the socket's
# address. Only behind Cloudflare with the origin closed to everyone else.
OPENTAXRATE_TRUST_CF=
# A header naming the visitor's IP, for the limits, when the API's only caller
# is a proxy that sets it (e.g. X-Client-IP from the opentaxrate.com Worker).
# Takes precedence over OPENTAXRATE_TRUST_CF.
OPENTAXRATE_CLIENT_IP_HEADER=
# Hours to keep each successful /v1/rate answer in memory (up to 5,000).
OPENTAXRATE_CACHE_HOURS=
# A Photon geocoder to relay /v1/suggest to (address suggestions as you type),
# e.g. http://100.115.89.94:2322 over Tailscale. Unset, /v1/suggest is off.
OPENTAXRATE_PHOTON_URL=
# Suggestions allowed per IP on /v1/suggest, like OPENTAXRATE_PUBLIC_LIMIT.
OPENTAXRATE_SUGGEST_LIMIT=
# The providers a lookup without a key may use (geocoder ids, plus jev),
# e.g. photon,pelias. Unset: every configured provider.
OPENTAXRATE_PUBLIC_PROVIDERS=
# Keys for your own apps and tests, name=key comma-separated, each
# otr_master_ plus 32+ random characters (echo otr_master_$(openssl rand -hex 24)).
# Sent as x-api-key or Authorization: Bearer; every provider, no per-IP limit.
OPENTAXRATE_MASTER_KEYS=
# Accounts (sign-in by emailed code, API keys, credit); off unless set.
# openssl rand -base64 32. BETTER_AUTH_URL is where the dashboard is served
# (http://localhost:5173 with the landing's dev server).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Sign-in codes by Resend; unset outside production, codes are printed.
RESEND_API_KEY=
# Buying credit with Stripe Checkout; unset, the dashboard can't sell credit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. States answered from their own live lookup at the address's map
# point, instead of the loaded data, where it gives one rate across the
# point's margin: MO, CO, AK, or "all". Off by default; each is a live call
# per address, to a service the state has Avalara run.
STATE_LOOKUPS=
