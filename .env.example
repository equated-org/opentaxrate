# Optional. A third geocoder beside the Census Bureau's and OpenStreetMap's;
# the map engine places more addresses with it.
MAPBOX_ACCESS_TOKEN=
# Optional. Standardizes a range state's address its typed street doesn't
# place, for its ZIP+4 (Utah publishes only ZIP+4 ranges).
GEOCODIO_API_KEY=
# Optional. TypeSafe's Jev picks the ZIP's street a misspelled one is, when
# spelling alone can't. About $0.12 per 1,000 picks.
TYPESAFE_API_KEY=
# Sent to the states' sites and to Nominatim, whose policy asks for a contact.
OPENTAXRATE_USER_AGENT=opentaxrate (+https://github.com/you/your-fork; you@example.com)
# Streamlined and Missouri rows that ended before this date are not loaded
# (default 2020-01-01). Map-state rates are always kept in full.
OPENTAXRATE_HISTORY_FROM=
PORT=8080
DB_PORT=5433
# For a public deployment; each is off when unset.
# Origins allowed to call the API from a browser, comma-separated
# (e.g. https://opentaxrate.com,http://localhost:5173). Unset: no CORS headers.
OPENTAXRATE_CORS_ORIGINS=
# Lookups allowed per IP on /v1/rate, as count/unit pairs (s, min, hour, day).
# Over it: 429 RATE_LIMITED with Retry-After. Counts are per process, in memory.
OPENTAXRATE_PUBLIC_LIMIT=
# 1 to count by Cloudflare's CF-Connecting-IP header instead of the socket's
# address. Only behind Cloudflare with the origin closed to everyone else.
OPENTAXRATE_TRUST_CF=
# Hours to keep each successful /v1/rate answer in memory (up to 5,000).
OPENTAXRATE_CACHE_HOURS=
