{
	// The site (client/) on Cloudflare Workers, served at opentaxrate.com: the
	// static build plus worker.js forwarding /v1 and /photon to the API at
	// API_ORIGIN (deploy/compose.public.yml behind Cloudflare). Build in
	// client/ (PUBLIC_ACCOUNTS=on pnpm build, for sign-in and the
	// dashboard), then from this folder: wrangler deploy. The
	// PROXY_SECRET secret (wrangler secret put) matches the server's.
	// The account comes from CLOUDFLARE_ACCOUNT_ID, in the shell or in a
	// git-ignored .env here (wrangler reads it from this folder; see
	// .env.example). A fork changes the routes and CANONICAL_HOST to its domain.
	"$schema": "../node_modules/wrangler/config-schema.json",
	// The Worker keeps its first name: renaming it would deploy a new Worker
	// without PROXY_SECRET and move the custom domains.
	"name": "opentaxrate-landing",
	"main": "worker.js",
	"compatibility_date": "2026-10-01",
	"routes": [
		{ "pattern": "opentaxrate.com", "custom_domain": true },
		{ "pattern": "www.opentaxrate.com", "custom_domain": true }
	],
	"vars": { "CANONICAL_HOST": "opentaxrate.com", "API_ORIGIN": "https://api.opentaxrate.com" },
	"assets": {
		"directory": "../build",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": true
	},
	"ratelimits": [
		// Per visitor IP, per minute, at the edge.
		{ "name": "LOOKUPS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "SUGGESTIONS", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
		// Sign-in and dashboard calls.
		{ "name": "AUTH", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
	]
}
