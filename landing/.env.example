# Where the OpenTaxRate API is. The browser calls ${PUBLIC_API_URL}/v1/rate.
# Leave empty in dev to go through Vite's proxy to API_PROXY_TARGET instead
# (useful when the API doesn't send CORS headers yet).
PUBLIC_API_URL=http://localhost:8080
# API_PROXY_TARGET=http://localhost:8080

# Address autocomplete: photon (no key; the default) or geoapify.
PUBLIC_SUGGEST=photon
PUBLIC_PHOTON_URL=https://photon.komoot.io
# Needed when PUBLIC_SUGGEST=geoapify. It ships in the bundle, so restrict it
# to the site's origins in the Geoapify console.
PUBLIC_GEOAPIFY_KEY=

# Dev server only. Set PUBLIC_PHOTON_URL=/photon to reach a Photon that sends
# no CORS headers (e.g. a self-hosted one started without -cors-any).
# PHOTON_PROXY_TARGET=http://localhost:2322
