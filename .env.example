# Optional. A third geocoder beside the Census Bureau's and OpenStreetMap's;
# the map engine places more addresses with it.
MAPBOX_ACCESS_TOKEN=
# Sent to the states' sites and to Nominatim, whose policy asks for a contact.
OPENTAXRATE_USER_AGENT=opentaxrate (+https://github.com/you/your-fork; you@example.com)
# Keep rows older than this when loading (default 2020-01-01).
OPENTAXRATE_HISTORY_FROM=
PORT=8080
DB_PORT=5433
