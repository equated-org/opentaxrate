# Copy to deploy/.env on the server (git-ignored) and pass it with
#   docker compose --env-file deploy/.env -f docker-compose.yml -f deploy/compose.public.yml up -d
# A Photon for /v1/suggest, over a private network (e.g. Tailscale).
OPENTAXRATE_PHOTON_URL=http://geocoder.example.test:2322
# Sent to the states' sites and to Nominatim, whose policy asks for a contact.
OPENTAXRATE_USER_AGENT=opentaxrate (+https://opentaxrate.com)
# The API's public hostname (a proxied Cloudflare DNS record to this server).
API_HOST=api.opentaxrate.com
# Shared with the Worker (wrangler secret put PROXY_SECRET); proves a request
# came through it, so the visitor IP it passes is trusted. openssl rand -hex 32
PROXY_SECRET=
# Private keys for your apps and tests (name=otr_master_...). Store values in your secret manager.
OPENTAXRATE_MASTER_KEYS=
# Accounts: sign-in by emailed code, API keys, prepaid credit. Off unless
# BETTER_AUTH_SECRET is set (openssl rand -base64 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://opentaxrate.com
# Sends the sign-in codes from hello@opentaxrate.com (verify the domain
# in Resend).
RESEND_API_KEY=
